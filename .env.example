
# Flask Environment configuration
FLASK_ENV=production
HOST=127.0.0.1
PORT=5000

# Security Configurations
# Secret key used for secure session cookie signing. Update this to a secure random string in production!
SECRET_KEY=greenvoyage-secure-dev-key-change-me-in-production

# Permitted CORS origins. Comma-separated list. Use * to allow all (not recommended in production).
ALLOWED_ORIGINS=*

# SQLite database file path relative to project root or absolute path
DATABASE_URL=sqlite:///greenvoyage.db
